{
  "manifest_version": 3,
  "name": "Flow Unlock",
  "version": "1.0.0",
  "description": "Патчит клиентскую проверку региона Google Flow. Работает только на flow.google.com.",
  "minimum_chrome_version": "111",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": ["https://flow.google.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Unlock",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
